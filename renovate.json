{
  "$schema": "https://renovatebot.com",
  "extends": [
    "config:recommended"
  ],
  "forkProcessing": "enabled",
  "prConcurrentLimit": 0,
  "packageRules": [
    {
      "matchManagers": ["dockerfile", "docker-compose", "github-actions"],
      "pinDigests": true
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "K3s version in the bash installer",
      "managerFilePatterns": [
        "/^kubernetes/install-k3s\\.sh$/"
      ],
      "matchStrings": [
        "K3S_VERSION:-(?<currentValue>[^}]+)"
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "Kubernetes version in the bash installer",
      "managerFilePatterns": [
        "/^kubernetes/install-k8s\\.sh$/"
      ],
      "matchStrings": [
        "K8S_VERSION:-(?<currentValue>v[0-9.]+)"
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Flannel CNI version in the bash installer",
      "managerFilePatterns": [
        "/^kubernetes/install-k8s\\.sh$/"
      ],
      "matchStrings": [
        "FLANNEL_VERSION:-(?<currentValue>v[0-9.]+)"
      ],
      "depNameTemplate": "flannel-io/flannel",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Poetry version in the Dockerfile and the workflow",
      "managerFilePatterns": [
        "/^Dockerfile$/",
        "/^\\.github/workflows/build\\.yaml$/"
      ],
      "matchStrings": [
        "poetry==(?<currentValue>[0-9][0-9.]*)"
      ],
      "depNameTemplate": "poetry",
      "datasourceTemplate": "pypi"
    }
  ]
}
